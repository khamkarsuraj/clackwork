// The Mac App Store build. Same app as the direct download, compiled with
// APP_STORE and never linked against Sparkle; the App Store handles updates.

#include "Shared.xcconfig"

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) APP_STORE

// Both targets build thlick.app into the same folder, as Xcode's test runner expects;
// whichever scheme you build last is the app that's there.
